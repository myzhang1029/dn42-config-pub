#!/usr/sbin/nft -f
# vi: ft=nftables
# /etc/nftables/main.nft

flush ruleset

table inet main {
    # dn42 assigned addresses
    set dn42_self_ipv4 {
        type ipv4_addr
    }
    set dn42_self_ipv6 {
        type ipv6_addr
        elements = { fdc0:d227:306:2c01:0:5d2:2:ad10 }
    }
    # dn42 services on this host
    set dn42_ports {
        type inet_proto . inet_service
        elements = { tcp . 8073 }
    }
    set dn42_bgp_src4 { type ipv4_addr }
    set dn42_bgp_src6 { type ipv6_addr }

    chain forward_machdep {}

    include "/etc/nftables/shared-chains.nft"

    chain input_everywhere {
        tcp dport { ssh, http, https, 8073 } accept
    }

    chain input_machdep {
        ip6 daddr fe80::/64 udp dport dhcpv6-client accept
    }
}
