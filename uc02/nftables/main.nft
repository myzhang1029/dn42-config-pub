#!/usr/sbin/nft -f
# vi: ft=nftables
# /etc/nftables/main.nft

flush ruleset

table inet main {
    chain forward_machdep {}

    include "/etc/nftables/shared-chains.nft"

    chain input_everywhere {
        tcp dport { ssh, http, https, 8073 } accept
    }

    chain input_machdep {
        ip6 daddr fe80::/64 udp dport dhcpv6-client accept
    }
}
