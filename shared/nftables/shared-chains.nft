# vi: ft=nftables
# /etc/nftables/shared-chains.nft

# Definitions and output, forward common, and protocol chains (adopted from FirewallD)

# Usage:
# main.nft MUST define:

# - chain input_everywhere (no hook), fallthrough if not accepted
#   Will be executed first.
#   Typically, it should accept traffic that should be accepted no matter where
#   it comes from or what the destination address is, but its rules can be more specific if desired.
#
# - chain input_machdep (no hook), all fallthrough will be dropped
#   Will be executed after input_everywhere and the dn42/internal input chains.
#   Stuff from neither the internal nor dn42 interfaces, and not already accepted by input_everywhere either
#
# - chain forward_machdep (no hook), fallthrough will be forwarded if routable among dn42 or as211585
#
# - set dn42_self_ipv4 (type ipv4_addr), local dn42 IPv4 addresses
# - set dn42_self_ipv6 (type ipv6_addr), local dn42 IPv6 addresses
# - set dn42_ports (type inet_proto . inet_service), services allowed to local exposed to dn42
# - set dn42_bgp_src4 (type ipv4_addr), accepted BGP/BFD source IPs
# - set dn42_bgp_src6 (type ipv6_addr), accepted BGP/BFD source IPs


### Definitions

define internal_ifgroup = 4040
define dn42_ifgroup = 4242
define inet_ifgroup = 211585

set dn42_self_ipv4_prefix {
    type ipv4_addr
    flags interval
    elements = { 172.23.6.160/27 }
}

set dn42_self_ipv6_prefix {
    type ipv6_addr
    flags interval
    elements = { fdc0:d227:306::/48 }
}

set inet_self_ipv4_prefix {
    type ipv4_addr
    flags interval
    elements = { 44.30.70.0/24 }
}

set inet_self_ipv6_prefix {
    type ipv6_addr
    flags interval
    elements = { 2001:67c:878::/48, 2a0f:6282:2100::/44 }
}


### dn42 common stuff

counter dn42_fwd_packets {
    comment "dn42 packets"
}

chain _input_internal {
    ip6 saddr fe80::/64 udp dport babel accept
    # bird-lgproxy
    ip6 daddr @dn42_self_ipv6 ip6 saddr { fdc0:d227:306:ee01::1, fdc0:d227:306:ca04::1 } tcp dport 8000 accept
}

# Input chain for internal and dn42 interfaces.
# Always accept (iface and daddr-based) inet traffic before this chain
chain _input_dn42 {
    ip6 saddr fe80::/64 meta l4proto . th dport { tcp . bgp, udp . bfd-control } accept
    iifgroup $internal_ifgroup ip6 saddr @dn42_self_ipv6_prefix meta l4proto . th dport { tcp . bgp, udp . bfd-control } accept
    ip saddr @dn42_bgp_src4 meta l4proto . th dport { tcp . bgp, udp . bfd-control } accept
    ip6 saddr @dn42_bgp_src6 meta l4proto . th dport { tcp . bgp, udp . bfd-control } accept
    iifgroup $internal_ifgroup jump _input_internal
    # Public-facing dn42 services
    meta l4proto . th dport @dn42_ports ip daddr @dn42_self_ipv4 accept
    meta l4proto . th dport @dn42_ports ip6 daddr @dn42_self_ipv6 accept
    reject with icmpx admin-prohibited
}

### Common chains

chain input {
    type filter hook input priority filter; policy drop;
    jump _input_limit_icmp
    jump _input_allow_ct_lo
    jump input_everywhere
    # Order doesn't really matter for the following two
    iifgroup { $dn42_ifgroup, $internal_ifgroup } jump _input_dn42
    jump input_machdep
    counter reject with icmpx admin-prohibited
}

chain output {
    type filter hook output priority filter; policy accept;
    tcp flags syn tcp option maxseg size set rt mtu
    oifname "lo" accept
    jump filter_policy_drop_martian
    # Accept outbound traffic everywhere
}

chain _forward_dn42 {
    # Count all non-self traffic
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } ip saddr @dn42_self_ipv4 notrack accept
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } ip daddr @dn42_self_ipv4 notrack accept
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } ip6 saddr @dn42_self_ipv6 notrack accept
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } ip6 daddr @dn42_self_ipv6 notrack accept
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } counter name dn42_fwd_packets notrack accept
}

chain forward {
    type filter hook forward priority filter; policy drop;
    tcp flags syn tcp option maxseg size set rt mtu
    iifname "lo" accept
    jump filter_policy_drop_martian

    ct state { established, related } accept
    ct status dnat accept

    # Check system-specific configurations
    jump forward_machdep

    # Accept all traffic within the dn42 network without conntrack
    jump _forward_dn42

    # AS211585
    iifgroup { $inet_ifgroup, $internal_ifgroup } ip6 daddr @inet_self_ipv6_prefix counter accept
    oifgroup { $inet_ifgroup, $internal_ifgroup } ip6 saddr @inet_self_ipv6_prefix counter accept
    iifgroup { $inet_ifgroup, $internal_ifgroup } ip daddr @inet_self_ipv4_prefix counter accept
    oifgroup { $inet_ifgroup, $internal_ifgroup } ip saddr @inet_self_ipv4_prefix counter accept

    iifgroup $inet_ifgroup counter drop
    ct state invalid log prefix "forward_STATE_INVALID_DROP: " drop
    counter reject with icmpx admin-prohibited
}

# [CVE-2021-3773] force port randomization for non-locally originated
# connections using suspicious port values to prevent port-shadow
# attacks, i.e. accidental matching of new inbound connections vs.
# existing ones
chain do_masquerade {
    meta iif > 0 th sport < 16384 th dport >= 32768 masquerade random
    masquerade
}

### Protocol chains

# Allow required ICMP and limit rates of other ICMP
chain _input_limit_icmp {
    icmpv6 type { nd-neighbor-advert, nd-neighbor-solicit, nd-router-advert, nd-redirect } accept
    meta l4proto { icmp, ipv6-icmp } limit rate 100/second accept
}

# Allow ct connections and lo
chain _input_allow_ct_lo {
    ct state { established, related } accept
    ct status dnat accept
    iifname "lo" accept
    ct state invalid log prefix "input_STATE_INVALID_DROP: " drop
}

chain filter_policy_drop_martian {
    ip6 daddr {
        ::/96, ::ffff:0.0.0.0/96,
        2002::/24, 2002:a00::/24,
        2002:7f00::/24, 2002:a9fe::/32,
        2002:ac10::/28, 2002:c0a8::/32,
        2002:e000::/19
    } log prefix "RFC3964_IPv4_REJECT: " reject with icmpv6 addr-unreachable
}
