# vi: ft=nftables
# /etc/nftables/shared-chains.nft

# This file is intended to be included by /etc/nftables/main.nft or /etc/nftables.conf
# It defines shared definitions, and a default set of {input, output, forward}
# chains flexible enough to be applicable to all hosts.
# More specific functions like ct_notrack should be defined separately in the
# including file.

# Usage:
# main.nft MUST define:

# Protection sets (list of blacklisted proto/port combinations by peer address):
# - set attacker4_by_service (type inet_proto . inet_service . ipv4_addr)
# - set attacker6_by_service (type inet_proto . inet_service . ipv6_addr)
#
# Input sets (list of accepted proto/port combinations by local address):
# - set local_services_ipv4 (type ipv4_addr . inet_proto . inet_service)
# - set local_services_ipv6 (type ipv6_addr . inet_proto . inet_service)
# - set everywhere_services (type inet_proto . inet_service), for ones accepted wherever it is destined
#
# DN42 sets:
# - set dn42_self_ipv4 (type ipv4_addr), local dn42 IPv4 addresses
# - set dn42_self_ipv6 (type ipv6_addr), local dn42 IPv6 addresses
# - set dn42_ports (type inet_proto . inet_service), services allowed to local exposed to dn42
# - set dn42_bgp_src4 (type ipv4_addr), accepted BGP/BFD source IPs
# - set dn42_bgp_src6 (type ipv6_addr), accepted BGP/BFD source IPs
#
# Chains:
# - chain input_machdep (no hook)
#   Will be executed after the blacklist and input sets described below,
#   to allow input traffic in a more flexible manner.
#   All fallthrough will be dropped.
#
# - chain forward_machdep (no hook)
#   Fallthrough will be forwarded if routable among dn42 or as211585,
#   and rejected otherwise.
#


### Definitions

define internal_ifgroup = 4040
define dn42_ifgroup = 4242
define inet_ifgroup = 211585

set dn42_self_ipv4_prefix {
    type ipv4_addr
    flags interval
    elements = { 172.23.6.160/27 }
}

set dn42_self_ipv6_prefix {
    type ipv6_addr
    flags interval
    elements = { fdc0:d227:306::/48 }
}

set inet_routed_ipv4_prefix {
    type ipv4_addr
    flags interval
    elements = { 44.30.70.0/24 }
}

set inet_routed_ipv6_prefix {
    type ipv6_addr
    flags interval
    elements = { 2001:67c:878::/48, 2a0f:6282:2100::/44, 2602:f92a:1316::/48 }
}

### Common chains

chain input {
    type filter hook input priority filter; policy drop;

    ct state { established, related } accept
    ct status dnat accept
    iifname "lo" accept

    # Blacklist these items
    meta l4proto . th dport . ip6 saddr @attacker6_by_service drop
    meta l4proto . th dport . ip saddr @attacker4_by_service drop

    # Allow these items (traffic to allowed local services)
    meta l4proto . th dport @everywhere_services accept
    ip6 daddr . meta l4proto . th dport @local_services_ipv6 accept
    ip daddr . meta l4proto . th dport @local_services_ipv4 accept

    icmpv6 type { nd-neighbor-advert, nd-neighbor-solicit, nd-router-advert, nd-redirect } accept
    meta l4proto { icmp, ipv6-icmp } limit rate 100/second accept

    # Nothing before this line should contain rejects
    # (see the end of `chain forward`),
    # but there may be rejects in `chain input_machdep` or `chain _input_dn42`,
    # so we drop ct invalid packets here.
    # Notably, don't drop ct invalid icmp since there are `notrack`s for some of them.
    ct state invalid drop
    # Allow machdep rules to override _input_dn42 too
    jump input_machdep
    iifgroup { $dn42_ifgroup, $internal_ifgroup } jump _input_dn42

    # We DROP input traffic that isn't explicitly accepted above,
    # since this is what the Oracle firewall does as well
    drop
}

chain output {
    type filter hook output priority filter; policy accept;
    tcp flags syn tcp option maxseg size set rt mtu
    oifname "lo" accept
    jump filter_policy_drop_martian
    # Accept outbound traffic everywhere
}

chain forward {
    type filter hook forward priority filter; policy drop;
    tcp flags syn tcp option maxseg size set rt mtu
    iifname "lo" accept
    jump filter_policy_drop_martian

    ct state { established, related } accept
    ct status dnat accept

    # Check system-specific configurations
    jump forward_machdep

    # Accept all traffic within the dn42 network without conntrack
    # Count all non-self traffic
    iifgroup { $dn42_ifgroup, $internal_ifgroup } oifgroup { $dn42_ifgroup, $internal_ifgroup } jump _forward_dn42

    # AS211585
    iifgroup { $inet_ifgroup, $internal_ifgroup } ip6 daddr @inet_routed_ipv6_prefix accept
    oifgroup { $inet_ifgroup, $internal_ifgroup } ip6 saddr @inet_routed_ipv6_prefix accept
    iifgroup { $inet_ifgroup, $internal_ifgroup } ip daddr @inet_routed_ipv4_prefix accept
    oifgroup { $inet_ifgroup, $internal_ifgroup } ip saddr @inet_routed_ipv4_prefix accept

    # For incoming traffic from peers/providers, drop them to protect ourselves
    iifgroup $inet_ifgroup counter drop
    # ct invalid should never be rejected to avoid breaking stuff
    # https://serverfault.com/a/1031084
    ct state invalid drop
    # REJECT disallowed forwarding traffic to aid troubleshooting and debugging
    # since we serve third-party networks.
    counter reject with icmpx admin-prohibited
}

# [CVE-2021-3773] force port randomization for non-locally originated
# connections using suspicious port values to prevent port-shadow
# attacks, i.e. accidental matching of new inbound connections vs.
# existing ones
chain do_masquerade {
    meta iif > 0 th sport < 16384 th dport >= 32768 masquerade random
    masquerade
}

### Protocol chains

chain filter_policy_drop_martian {
    ip6 daddr {
        ::/96, ::ffff:0.0.0.0/96,
        2002::/24, 2002:a00::/24,
        2002:7f00::/24, 2002:a9fe::/32,
        2002:ac10::/28, 2002:c0a8::/32,
        2002:e000::/19
    } log prefix "RFC3964_IPv4_REJECT: " reject with icmpv6 addr-unreachable
}

### dn42 common stuff

counter dn42_fwd_packets {
    comment "dn42 packets"
}

chain _input_internal {
    # Routing control plane is v6-only :)
    ip6 saddr fe80::/64 udp dport babel accept
    ip6 saddr @dn42_self_ipv6_prefix meta l4proto . th dport { tcp . bgp, udp . bfd-multi-ctl } accept
    # bird-lgproxy
    ip6 daddr @dn42_self_ipv6 ip6 saddr { fdc0:d227:306:ee01::1, fdc0:d227:306:ca04::1 } tcp dport 8000 accept
}

# Input chain for internal and dn42 interfaces
# Always accept (iface and daddr-based) inet traffic before this chain
chain _input_dn42 {
    ip6 saddr fe80::/64 meta l4proto . th dport { tcp . bgp, udp . bfd-control } accept
    ip6 saddr @dn42_bgp_src6 meta l4proto . th dport { tcp . bgp, udp . bfd-multi-ctl } accept
    ip saddr @dn42_bgp_src4 meta l4proto . th dport { tcp . bgp, udp . bfd-multi-ctl } accept
    iifgroup $internal_ifgroup jump _input_internal
    # Public-facing dn42 services
    meta l4proto . th dport @dn42_ports ip6 daddr @dn42_self_ipv6 accept
    meta l4proto . th dport @dn42_ports ip daddr @dn42_self_ipv4 accept
    # Be nice to other participants and let them know something got rejected
    reject with icmpx admin-prohibited
}

chain _forward_dn42 {
    ip6 saddr @dn42_self_ipv6 accept
    ip6 daddr @dn42_self_ipv6 accept
    ip saddr @dn42_self_ipv4 accept
    ip daddr @dn42_self_ipv4 accept
    counter name dn42_fwd_packets accept
}
