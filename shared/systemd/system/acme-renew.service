# vi: ft=systemd
# /etc/systemd/system/acme-renew.service
#
# useradd --system --home-dir /var/lib/acmesh --shell /sbin/nologin --create-home acmesh
#
# Write the reload commands in ExecStartPost instead of acmesh's reloadcmd
# so that SELinux rules don't have to be overcomplicated
#
# Make the .well-known/acme-challenge directory mode 0775 and group acmesh

[Unit]
Description=acme.sh certificate renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=acmesh
ExecStart=/var/lib/acmesh/.acme.sh/acme.sh --cron --home /var/lib/acmesh/.acme.sh
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/acmesh /etc/acmesh
