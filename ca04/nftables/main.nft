#!/usr/sbin/nft -f
# vi: ft=nftables
# /etc/nftables/main.nft

flush ruleset


table inet main {
    # dn42 WireGuard listening ports
    set dn42_wg_ports {
        type inet_service
        elements = {
            24300,
            24301,
            24204,
            24211,
            24205,
            24206,
            24207,
            24209,
            24213,
            24210,
            24211,
            24215,
            24216,
            24212,
            24239,
            24217,
            # __MAKE_PEERING_PORT_MARKER Do not remove this comment
        }
    }
    # dn42 assigned addresses
    set dn42_self_ipv4 {
        type ipv4_addr
        elements = { 172.23.6.161 }
    }
    set dn42_self_ipv6 {
        type ipv6_addr
        elements = { fdc0:d227:306:ee01::1, fdc0:d227:306:ca04::1 }
    }
    # dn42 services on this host
    set dn42_ports {
        type inet_proto . inet_service
        counter
        elements = {
            tcp . domain,
            udp . domain,
            tcp . http,
            tcp . https,
            udp . https,
            udp . ntp,
            tcp . 8082, # StayRTR dn42
            tcp . 8282, # StayRTR inet
        }
    }
    set dn42_bgp_src4 {
        type ipv4_addr
    }
    set dn42_bgp_src6 {
        type ipv6_addr
        elements = {
            fd10:127:42:ffff::1, # Nedifinita IX
        }
    }

    # Public interface
    set public_interfaces {
        type ifname
        elements = { "enp0s6" }
    }
    set oracle_interfaces {
        type ifname
        elements = { "enp0s6" }
    }

    include "/etc/nftables/blacklist.nft"
    include "/etc/nftables/oracle.nft"
    include "/etc/nftables/shared-chains.nft"
    include "/etc/nftables/private-chains.nft"

    chain forward_machdep {
        oifname @public_interfaces meta l4proto tcp log prefix "forward_WAN_access: " reject
        oifname @public_interfaces reject
    }

    chain mark_in {
        type filter hook prerouting priority mangle; policy accept;
        iifgroup $inet_ifgroup ip6 daddr @inet_self_ipv6_prefix ct mark set 211585
        iifgroup $inet_ifgroup ip daddr @inet_self_ipv4_prefix ct mark set 211585
    }
    chain remark_out {
        type route hook output priority mangle; policy accept;
        ct mark 211585 counter meta mark set 211585
    }
}
