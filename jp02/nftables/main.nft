#!/usr/sbin/nft -f
# vi: ft=nftables
# /etc/nftables/main.nft

flush ruleset


table inet main {
    # dn42 WireGuard listening ports
    set dn42_wg_ports {
        type inet_service
        elements = {
            24303,
            24305,
            24201,
            24203,
            24211,
            24212,
            24206,
            24239,
            24209,
            24207,
            24204,
            24299,
            24277,
            24272,
            24288,
            24241,
            24242,
            24224,
            24205,
            24208,
            24210,
            # __MAKE_PEERING_PORT_MARKER Do not remove this comment
        }
    }
    # dn42 assigned addresses
    set dn42_self_ipv4 {
        type ipv4_addr
        elements = { 172.23.6.162 }
    }
    set dn42_self_ipv6 {
        type ipv6_addr
        elements = {
            fdc0:d227:306:ee01::2,
            fdc0:d227:306:aa02::1,
            fdc0:d227:306:aa02::2, # for flapalerted
        }
    }
    # dn42 services on this host
    set dn42_ports {
        type inet_proto . inet_service
        counter
        elements = {
            udp . ntp,
            tcp . domain,
            udp . domain,
            tcp . https, # FlapAlerted
            tcp . 1790, # FlapAlerted
        }
    }
    set dn42_bgp_src4 { type ipv4_addr; }
    set dn42_bgp_src6 { type ipv6_addr; }

    # Public interface
    set public_interfaces {
        type ifname
        elements = { "enp0s6" }
    }
    set oracle_interfaces {
        type ifname
        elements = { "enp0s6" }
    }

    include "/etc/nftables/oracle.nft"
    include "/etc/nftables/blacklist.nft"
    include "/etc/nftables/shared-chains.nft"
    include "/etc/nftables/private-chains.nft"

    chain forward_machdep {
        iifgroup $internal_ifgroup oifname @public_interfaces counter accept
    }
}
