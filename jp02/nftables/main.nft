#!/usr/sbin/nft -f
# vi: ft=nftables
# /etc/nftables/main.nft

flush ruleset


table inet main {
    # dn42 WireGuard listening ports
    set dn42_wg_ports {
        type inet_service
        elements = {
            24303,
            24201,
            24203,
            24211,
            24202,
            24212,
            24206,
            24239,
            24209,
            24207,
            24204,
            24299,
            24277,
            24272,
            24234,
            24240,
            24288,
            24241,
            24242,
            24224,
            24205,
            24208,
            # __MAKE_PEERING_PORT_MARKER Do not remove this comment
        }
    }
    # dn42 assigned addresses
    set dn42_self_ipv4 {
        type ipv4_addr
        elements = { 172.23.6.162 }
    }
    set dn42_self_ipv6 {
        type ipv6_addr
        elements = {
            fdc0:d227:306:ee01::2,
            fdc0:d227:306:aa02::1,
            fdc0:d227:306:aa02::2, # for flapalerted
        }
    }
    # dn42 services on this host
    set dn42_ports {
        type inet_proto . inet_service
        counter
        elements = {
            tcp . domain,
            udp . domain,
            tcp . 180,
            tcp . https, # FlapAlerted
            tcp . 1790, # FlapAlerted
        }
    }

    # Public interface
    set public_interfaces {
        type ifname
        elements = { "enp0s6" }
    }
    set oracle_interfaces {
        type ifname
        elements = { "enp0s6" }
    }

    include "/etc/nftables/oracle.nft"
    include "/etc/nftables/shared-chains.nft"
    include "/etc/nftables/public-chains.nft"

    chain forward_machdep {
        iifgroup $internal_ifgroup oifname @public_interfaces counter accept
    }

    chain nat_post {
        type nat hook postrouting priority srcnat + 10; policy accept;
        oifname @public_interfaces goto nat_post_public
    }

    chain input_everywhere {
        tcp dport ssh accept
        ip saddr @inet_self_ipv4_prefix udp dport domain accept
        ip saddr @inet_self_ipv4_prefix tcp dport domain accept
        ip6 saddr @inet_self_ipv6_prefix udp dport domain accept
        ip6 saddr @inet_self_ipv6_prefix tcp dport domain accept
    }

    chain input_machdep {
        iifname @oracle_interfaces ip6 daddr fe80::/64 udp dport dhcpv6-client accept
        iifname @oracle_interfaces udp dport @dn42_wg_ports accept
    }
}
