# vi: ft=systemd
# /etc/systemd/network/30-dn42-iedon-grc.netdev

[NetDev]
Name=wg2189iedongrc
Kind=wireguard
Description=WireGuard tunnel to AS4242422189 iEdon GRC HK

[WireGuard]
ListenPort=24210
PrivateKeyFile=/etc/systemd/network/dn42.wgkey

[WireGuardPeer]
PublicKey=T/s3VJ2c3Evr4Ie2OEXsAWKsRImd1cIzE1UvEpVOwSQ=
Endpoint=hk.grc.dn42.iedon.net:44523
AllowedIPs=10.0.0.0/8
AllowedIPs=172.20.0.0/14
AllowedIPs=172.31.0.0/16
AllowedIPs=fd00::/8
AllowedIPs=fe80::/64
